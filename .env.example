# ══════════ Supabase ══════════
# Dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# ⚠️ service_role key 绕过 RLS，只用于 ingest 脚本 / Actions Secrets，绝不放进前端
SUPABASE_SERVICE_KEY=

# ══════════ GitHub ══════════
# PAT：公开仓库只读权限即可（classic 勾 public_repo，或 fine-grained 只读 Public repositories）
GITHUB_TOKEN=

# ══════════ AI 归类（OpenAI 兼容接口，可选） ══════════
# 不配置则只使用规则分类。GLM 示例: AI_BASE_URL=https://api.z.ai/api/paas/v4  AI_MODEL=glm-4.5-flash
# DeepSeek 示例:  AI_BASE_URL=https://api.deepseek.com        AI_MODEL=deepseek-chat
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ══════════ 站点（可选，ingest 完成后刷新前端缓存） ══════════
SITE_URL=http://localhost:3000
REVALIDATE_SECRET=换成一个随机字符串
